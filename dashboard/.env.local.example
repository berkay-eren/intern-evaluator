# Supabase proje URL'i -- Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon (public) anahtar. Tarayiciya gidebilir; tablolardaki RLS politikasi
# yalnizca `select` izni verdigi icin bu anahtarla yazma yapilamaz.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role anahtari. SADECE sunucu tarafinda kullanilir; private `cvs`
# bucket'i icin imzali indirme baglantisi uretmeye yarar.
# Adinda NEXT_PUBLIC_ yok, bu yuzden Next.js istemci paketine dahil etmez.
# ASLA repoya commit'lenmez.
SUPABASE_SERVICE_ROLE_KEY=
